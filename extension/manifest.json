{
  "manifest_version": 3,
  "name": "Carbon Pet for ChatGPT",
  "description": "Estimate visible ChatGPT token usage and send CO2 estimates to the local Carbon Pet desktop app.",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost:8888/*",
    "http://127.0.0.1:8888/*"
  ]
}
