{
  "manifest_version": 3,
  "name": "carb-0n for AI Chatbots",
  "description": "Estimate visible token usage and send CO2 estimates to the local carb-0n desktop app for ChatGPT, Gemini and Claude.",
  "version": "0.2.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost:8888/*",
    "http://127.0.0.1:8888/*"
  ]
}